{
  "rewrites": [
    { "source": "/analyze", "destination": "/api/index.py" },
    { "source": "/status/(.*)", "destination": "/api/index.py" },
    { "source": "/cancel/(.*)", "destination": "/api/index.py" },
    { "source": "/ask", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
